{
  "name": "kuquest-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "lint:type": "oxlint src --type-aware",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit/*.test.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:mock": "playwright test --config=playwright.config.ts",
    "test:e2e:admin-shell": "playwright test --config=playwright.admin-shell.config.ts",
    "test:e2e:security": "playwright test --config=playwright.admin-security.config.ts",
    "test:e2e:quest": "playwright test --config=playwright.quest.config.ts",
    "test:e2e:quest:api": "playwright test --config=playwright.quest-api.config.ts",
    "test:e2e:payout:live": "playwright test --config=playwright.payout-live.config.ts",
    "test:e2e:wallet:live": "playwright test --config=playwright.wallet-live.config.ts",
    "test:e2e:wallet:error": "playwright test --config=playwright.wallet-error.config.ts",
    "test:e2e:wallet:initial-error": "playwright test --config=playwright.wallet-initial-error.config.ts",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
